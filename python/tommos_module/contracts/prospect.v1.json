{
  "$id": "https://app.tommos.ai/modules/contracts/prospect.v1.json",
  "title": "Prospect",
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "name",
    "evidence",
    "matched"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^(?!www\\.)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "maxLength": 253,
      "description": "The company's own website: lower case, no www, no path."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "matched": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "The rule of the module that took this company, as a fact: «a Show HN launch with its own website»."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "url"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "score": {
      "type": "number"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "people": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
